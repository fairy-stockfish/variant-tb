GENTBNAME = mtbgen_unused
GENTBPNAME = mtbgenp
VERTBNAME = mtbver_unused
VERTBPNAME = mtbverp_unused
CLEAN = mclean

DEPDIR = .depsm
OBJDIR = objsm

FLAGS += -DSHATRANJ -DMAKRUK

include Makefile.general

MGENTBOBJS = mtbgen.o compress.o huffman.o threads.o lz4.o checksum.o city-c.o util.o
MPROBEOBJS = mprobe.o threads.o util.o

include $(MGENTBOBJS:%.o=$(DEPDIR)/%.P)
include $(MPROBEOBJS:%.o=$(DEPDIR)/%.P)

mtbgen: $(MGENTBOBJS)
	$(CC) $(CFLAGS) -o mtbgen $(MGENTBOBJS:%=$(OBJDIR)/%) $(LDFLAGS)

mprobe: $(MPROBEOBJS)
	$(CC) $(CFLAGS) -o mprobe $(MPROBEOBJS:%=$(OBJDIR)/%) $(LDFLAGS)
